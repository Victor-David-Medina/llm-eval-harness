# Golden dataset for llm-eval-harness. One JSON object per line.
# Fields: id, input, context, expected, must_include. Optional: produced.
# Lines starting with '#' and blank lines are ignored by the loader.
# Flavor: small-business AI operations answers (lapsed-client recovery,
# scheduling, reviews, billing). All values here are illustrative samples,
# not real customer data.
{"id": "lapsed-client-winback-tone", "input": "A client has not booked in 5 months. Draft a short, warm win-back text that fits within the booking history below.", "context": "Client Dana booked a 60 minute deep tissue massage on 2025 01 12 and a 60 minute session on 2025 02 09. No bookings since. Average ticket 95 dollars. Preferred Saturday mornings.", "expected": "Hi Dana, it has been a little while since your last deep tissue session in February. Saturday mornings are open again if you would like to come back in. Reply yes and we will hold a 60 minute slot for you.", "must_include": ["Dana", "deep tissue", "Saturday"]}
{"id": "lapsed-client-no-invented-discount", "input": "Write a win-back message for a lapsed client without inventing any offer the owner did not approve.", "context": "Client Marcus last visited 2025 03 03. No discount has been approved by the owner. Owner policy is to never promise a price cut in automated messages.", "expected": "Hi Marcus, we have missed you since March. If you would like to come back in, reply here and we will find a time that works for your schedule.", "must_include": ["Marcus", "March"]}
{"id": "slot-rescue-same-day", "input": "A 2pm slot just opened from a cancellation. Draft an outreach to the most likely client to fill it today.", "context": "Today is Tuesday. A 2pm 30 minute slot opened at 1140am from a cancellation. Client Priya has asked twice this month for a Tuesday afternoon time and is on the short notice list.", "expected": "Hi Priya, a Tuesday 2pm 30 minute slot just opened today. You mentioned wanting a Tuesday afternoon, so I am offering it to you first. Reply yes to claim it.", "must_include": ["Priya", "2pm", "Tuesday"]}
{"id": "review-request-after-visit", "input": "Draft a review request for a client who left happy yesterday.", "context": "Client Tom completed a haircut and beard trim yesterday and told the barber he was very happy. The shop collects reviews on Google. The review link is https://g.page/r/example-shop.", "expected": "Hi Tom, glad you were happy with the cut and beard trim yesterday. If you have a minute, a quick Google review really helps the shop: https://g.page/r/example-shop", "must_include": ["Tom", "Google review", "https://g.page/r/example-shop"]}
{"id": "billing-question-grounded", "input": "A client asks why their card was charged 95 dollars. Answer using only the booking record.", "context": "Client Renee was charged 95 dollars on 2025 04 18 for a 60 minute deep tissue massage. The posted rate for that service is 95 dollars. No tip was added by the shop.", "expected": "Your card was charged 95 dollars on April 18 for the 60 minute deep tissue massage, which is the posted rate for that service. No tip was added by us.", "must_include": ["95", "deep tissue"]}
{"id": "scheduling-no-double-book", "input": "A client asks for Friday at 3pm. Confirm or offer the nearest open time using the calendar below.", "context": "Friday 3pm is already booked for another client. The nearest open times on Friday are 2pm and 415pm, both 60 minute slots.", "expected": "Friday at 3pm is already booked, but I can offer you Friday at 2pm or 415pm, both 60 minute slots. Which one works for you?", "must_include": ["Friday", "2pm", "415pm"]}
{"id": "no-show-followup-neutral", "input": "A client missed their appointment this morning. Write a neutral, non-accusatory follow up that invites a rebook.", "context": "Client Alex missed a 9am appointment this morning. Shop policy charges no fee for a first missed appointment. The goal is to rebook, not to scold.", "expected": "Hi Alex, we had you down for 9am this morning and missed you. No worries and no fee this time. Want me to find you a new time this week?", "must_include": ["Alex", "9am"]}
{"id": "membership-renewal-grounded", "input": "Remind a member their plan renews soon, using only the plan details given.", "context": "Client Sofia is on the monthly wellness plan at 79 dollars per month. The plan renews on the 1st of each month and includes two 60 minute sessions. Next renewal is May 1.", "expected": "Hi Sofia, your monthly wellness plan at 79 dollars renews on May 1 and includes two 60 minute sessions. Let me know if you would like to schedule them.", "must_include": ["Sofia", "79", "May 1"]}
{"id": "refund-policy-faithful", "input": "A client asks about a refund. State the actual policy from the context without softening or inventing exceptions.", "context": "Shop refund policy: refunds are available within 7 days of purchase for unused service packages only. Used sessions are not refundable. There are no other exceptions.", "expected": "Refunds are available within 7 days of purchase for unused service packages only. Sessions you have already used are not refundable, and there are no other exceptions.", "must_include": ["7 days", "unused"]}
{"id": "auto-repair-estimate-recovery", "input": "A customer got an estimate 3 weeks ago and never approved the work. Draft a follow up that quotes the exact estimate.", "context": "Customer Jordan received a brake pad and rotor estimate of 420 dollars on 2025 04 02 at the auto shop. The estimate is still valid. Parts are in stock.", "expected": "Hi Jordan, following up on your brake pad and rotor estimate of 420 dollars from April 2. The estimate is still good and the parts are in stock. Want to get on the schedule?", "must_include": ["Jordan", "420", "brake"]}
{"id": "consult-booking-confirm", "input": "Confirm a new consultation booking and restate the time so there is no confusion.", "context": "Client Bianca booked a free 20 minute intro consultation for Wednesday at 1030am. The consultation is by phone. Shop will call her.", "expected": "Hi Bianca, you are confirmed for a free 20 minute intro consultation on Wednesday at 1030am. It is by phone and we will call you. See you then.", "must_include": ["Bianca", "Wednesday", "1030am"]}
